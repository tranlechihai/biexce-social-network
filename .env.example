# Development default. Production runs the Docker deployment (see
# compose.yaml + docs/DOCKER_PG_HANDOFF.md) — the PostgreSQL URL below is
# for a manually installed PostgreSQL.
TING_DATABASE_URL=sqlite:///./ting_ting.db
# TING_DATABASE_URL=postgresql+psycopg://biexce_social:CHANGE_ME@127.0.0.1:5432/biexce_social
# Inside the compose network the host name is `db`:
# TING_DATABASE_URL=postgresql+psycopg://biexce_social:CHANGE_ME@db:5432/biexce_social
TING_JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
TING_JWT_EXPIRE_MINUTES=60
TING_COOKIE_SECURE=false
TING_RATE_LIMIT_ENABLED=true
TING_DEBUG=false
# Media storage directory. Dev: repo-relative "uploads". The compose app
# service sets TING_UPLOADS_DIR=/app/uploads (mounted volume) in compose.yaml.
TING_UPLOADS_DIR=uploads
# --- Docker deployment (deploy host, not this file) ---
# compose.yaml additionally requires, as process environment of the host:
#   POSTGRES_PASSWORD=CHANGE_ME_WITH_OPENSSL_RAND_HEX_16
